        set type other
        set is-file-launcher false
        set elevation none
        set launch-timeout 15
        config os_app
            edit 1
                set name "SSMS20"
                set os_type windows
                set multiprocess disable
                set fullscreen-record disable
                set exe "\"C:\\Program Files (x86)\\Microsoft SQL Server Management Studio 20\\Common7\\IDE\\Ssms.exe\""
                set parameter ''
                set proc-matcher-type default
                set client-software ''
                config fct-script
                    edit 1
                        set cmd "Window.ClearText.Path \"WindowsForms10.Window.8.app.0..*\" \"Connect to Server\" \"6.2.1.1.1.1.4.1\" 90000"
