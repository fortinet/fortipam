config secret password-changer
    edit "SSH Password FortiAnalyzer"
        config change
            edit 1
                set type expect
                set expect-action no-match-cont
                set command "to accept):"
                set delay 5000
            next
            edit 2
                set type execute
                set execute-action execute-on-match
                set command "a"
            next
            edit 3
                set type expect-prompt
                set expect-action no-match-abort
            next
            edit 4
                set type execute
                set command "config global"
            next
            edit 5
                set type expect-prompt
                set expect-action no-match-abort
            next
            edit 6
                set type execute
                set command "config system admin user"
            next
            edit 7
                set type expect
                set expect-action no-match-abort
                set command "(user)"
            next
            edit 8
                set type execute
                set command "edit $USER"
            next
            edit 9
                set type expect
                set expect-action no-match-abort
                set command "($USER)"
            next
            edit 10
                set type execute
                set command "set password \"$NEWPASSWD\""
            next
            edit 11
                set type expect-prompt
                set expect-action no-match-abort
                set delay 10000
            next
            edit 12
                set type execute
                set command "next"
            next
            edit 13
                set type expect-prompt
                set expect-action no-match-abort
            next
            edit 14
                set type execute
                set critical-step enable
                set command "end"
            next
            edit 15
                set type expect
                set expect-action no-match-abort
                set command "exit"
            next
            edit 16
                set type finish
            next
        end
    next
end
