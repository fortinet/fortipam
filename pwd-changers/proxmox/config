config secret password-changer
    edit "ProxMox"
        config change
            edit 1
                set type expect-prompt
                set delay 1000
            next
            edit 2
                set command "passwd"
            next
            edit 3
                set type expect
                set command "Current password:"
                set delay 1000
            next
            edit 4
                set command "$PASSWORD"
            next
            edit 5
                set type expect
                set command "New password:"
            next
            edit 6
                set command "$NEWPASSWD"
            next
            edit 7
                set type expect
                set command "Retype new password:"
                set delay 1000
            next
            edit 8
                set command "$NEWPASSWD"
            next
            edit 9
                set type expect
                set command "passwd: password updated successfully"
                set delay 1000
            next
        end
    next
end
